{
  "schemaVersion": 1,
  "desktop": {
    "favorites": [
      "com.mitchellh.ghostty.desktop",
      "chromium-browser.desktop",
      "code.desktop",
      "mysql-workbench.desktop",
      "org.gnome.Nautilus.desktop",
      "org.gnome.TextEditor.desktop"
    ],
    "colorScheme": "dark",
    "enableAnimations": true,
    "dock": {
      "position": "bottom",
      "iconSize": 40,
      "autoHide": true,
      "extendHeight": false,
      "showTrash": false,
      "showMounts": false
    }
  },
  "vscode": {
    "extensions": [
      "bmewburn.vscode-intelephense-client",
      "ecmel.vscode-html-css",
      "esbenp.prettier-vscode",
      "ms-python.debugpy",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-vscode.cpptools",
      "redhat.java",
      "ritwickdey.liveserver",
      "vscjava.vscode-java-debug",
      "vscjava.vscode-java-dependency",
      "vscjava.vscode-java-pack",
      "vscjava.vscode-java-test",
      "vscjava.vscode-maven",
      "xdebug.php-debug"
    ],
    "extraSettings": {
      "chat.agent.enabled": false,
      "chat.commandCenter.enabled": false,
      "chat.editor.fontFamily": "",
      "editor.tokenColorCustomizations": {
        "comments": "#72696a",
        "strings": "#f9cc6c",
        "keywords": "#fd6883",
        "functions": "#adda78",
        "numbers": "#a8a9eb",
        "types": "#85dacc",
        "variables": "#e6d9db"
      },
      "extensions.ignoreRecommendations": true,
      "github.copilot.chat.agent.enabled": false,
      "github.copilot.chat.enabled": false,
      "github.copilot.enable": {
        "*": false
      },
      "liveServer.settings.donotShowInfoMsg": true,
      "liveServer.settings.donotVerifyTags": true,
      "redhat.telemetry.enabled": false,
      "telemetry.telemetryLevel": "off",
      "update.enableWindowsBackgroundUpdates": false,
      "update.showReleaseNotes": false,
      "workbench.activityBar.visible": true,
      "workbench.auxiliaryBar.visible": false,
      "workbench.colorCustomizations": {
        "editor.background": "#2c2525",
        "editor.foreground": "#e6d9db",
        "editor.selectionBackground": "#403e41",
        "editor.lineHighlightBackground": "#352e2e",
        "editorCursor.foreground": "#c3b7b8",
        "sideBar.background": "#251f1f",
        "sideBar.foreground": "#e6d9db",
        "sideBarTitle.foreground": "#f38d70",
        "activityBar.background": "#211c1c",
        "activityBar.foreground": "#f38d70",
        "titleBar.activeBackground": "#211c1c",
        "titleBar.activeForeground": "#e6d9db",
        "statusBar.background": "#211c1c",
        "statusBar.foreground": "#948a8b",
        "terminal.background": "#2c2525",
        "terminal.foreground": "#e6d9db",
        "terminal.ansiBlack": "#72696a",
        "terminal.ansiRed": "#fd6883",
        "terminal.ansiGreen": "#adda78",
        "terminal.ansiYellow": "#f9cc6c",
        "terminal.ansiBlue": "#f38d70",
        "terminal.ansiMagenta": "#a8a9eb",
        "terminal.ansiCyan": "#85dacc",
        "terminal.ansiWhite": "#e6d9db",
        "terminal.ansiBrightBlack": "#948a8b",
        "terminal.ansiBrightRed": "#ff8297",
        "terminal.ansiBrightGreen": "#c8e292",
        "terminal.ansiBrightYellow": "#fcd675",
        "terminal.ansiBrightBlue": "#f8a788",
        "terminal.ansiBrightMagenta": "#bebffd",
        "terminal.ansiBrightCyan": "#9bf1e1",
        "terminal.ansiBrightWhite": "#f1e5e7",
        "tab.activeBackground": "#2c2525",
        "tab.inactiveBackground": "#251f1f",
        "panel.background": "#251f1f",
        "list.activeSelectionBackground": "#403e41",
        "list.hoverBackground": "#352e2e",
        "editorGroupHeader.tabsBackground": "#211c1c",
        "breadcrumb.background": "#2c2525"
      },
      "workbench.colorTheme": "Default Dark+",
      "workbench.panel.defaultLocation": "bottom",
      "workbench.secondarySideBar.defaultVisibility": "hidden",
      "workbench.secondarySideBar.visible": false,
      "workbench.sideBar.location": "left",
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": false,
      "workbench.welcomePage.enabled": false,
      "workbench.welcomePage.walkthroughs.enabled": false,
      "workbench.welcomePage.walkthroughs.openOnStartup": false
    }
  },
  "browser": {
    "defaultApplication": "chromium-browser.desktop"
  }
}
